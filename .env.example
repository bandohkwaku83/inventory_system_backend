# Local MongoDB (default port)
MONGODB_URI=mongodb://localhost:27017/inventory

# HTTP port (defaults to 8000)
# PORT=8000

# CORS origin for the Next.js frontend
# CORS_ORIGIN=http://localhost:3000

# JWT secret for auth (required for login)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Optional JWT expiry (default 7d)
# JWT_EXPIRES_IN=7d

# Default password for other seeded demo users (gra@, light@, multi@)
# Admin is always bandohkwaku@gmail.com / 123456 via seed.
# SEED_DEFAULT_PASSWORD=ChangeMe123!
