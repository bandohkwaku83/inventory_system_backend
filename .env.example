# =============================================================================
# inventory-backend — environment
# Copy to .env for local use. On your host (Render, Railway, VPS, etc.), set
# these as environment variables — do not commit real secrets.
# =============================================================================

# --- Database (required) ---
# Local:
#   MONGODB_URI=mongodb://127.0.0.1:27017/inventory
# Atlas / production:
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/inventory?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/inventory

# --- Server ---
# Most platforms inject PORT automatically; keep 8000 for local.
PORT=8000

# Frontend origin allowed by CORS (no trailing slash).
# Local:  http://localhost:3000
# Deploy: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:3001

# --- Auth (required) ---
# Use a long random string in production (never reuse the example value).
JWT_SECRET=change-me-generate-with-openssl-rand-hex-48
JWT_EXPIRES_IN=7d

# --- Seed (optional) ---
# Password for seeded demo users (gra@, light@, multi@).
# Admin remains bandohkwaku@gmail.com / 123456 from seed — change after deploy.
SEED_DEFAULT_PASSWORD=ChangeMe123!
